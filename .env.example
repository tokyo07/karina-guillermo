# Datos del proyecto Supabase de la invitación (ver README para cómo obtenerlos).
# Copiá este archivo a .env.local y completá los valores reales.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Álbum (/album): las fotos se guardan en Cloudinary.
# Cloud name: Dashboard de Cloudinary. Preset: Settings → Upload → Upload presets
# (modo "Unsigned"; ver README, sección Álbum).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=boda_album
